# Copy to .env. Every value has a default, so this file is optional.
PORT=8787
HOST=0.0.0.0

# qdrant = real Qdrant server (docker); memory = in-process, wiped on restart, no Docker needed
STORE=qdrant
QDRANT_URL=http://localhost:6333

# place_fact contributions accepted per device per UTC day
DAILY_CAP=50
# new device registrations per IP per hour
REGISTER_PER_HOUR=30

# dashboard access; CHANGE IT for anything but a local demo
ADMIN_KEY=dev-admin-key

DB_PATH=./server.db
# folder holding model_quantized.onnx and vocab.txt (default: <repo>/models)
MODEL_DIR=../../models
