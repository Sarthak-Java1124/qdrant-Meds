{
  "expo": {
    "name": "LastMeter",
    "slug": "lastmeter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lastmeter",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.lastmeter.rider"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lastmeter.rider",
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "react-native-qdrant-edge",
      "onnxruntime-react-native",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E5A45",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-background-task",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Aftercare reads prescriptions from photos you choose. The photo is read on this phone and is not stored or uploaded.",
          "cameraPermission": "Aftercare uses the camera to photograph a prescription. The photo is read on this phone and is not stored or uploaded."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Aftercare listens to your doctor visit so it can write it down. The audio is transcribed on this phone and is never uploaded.",
          "speechRecognitionPermission": "Aftercare uses speech recognition to turn your doctor visit into text on this phone."
        }
      ],
      "expo-mlkit-ocr",
      [
        "expo-camera",
        {
          "cameraPermission": "Aftercare uses the camera to photograph a prescription. The photo is read on this phone and is not stored or uploaded.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withVisionOcr.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
